# Public project URL (optional locally)
PUBLIC_SITE_URL=http://localhost:4321
# Supabase project settings. Never place the service-role key in this file.
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Required to sign in the administrator and deliver booking notifications.
PRIVATE_ADMIN_EMAIL=
PRIVATE_RESEND_API_KEY=
PRIVATE_MAIL_FROM=
# Opt-in only. Leave as "simulation" for tests; never set live in a test project.
PRIVATE_BOOKING_MAIL_MODE=simulation
# Test-only: comma-separated recipient(s) to fail locally (customer,admin).
PRIVATE_BOOKING_MAIL_SIMULATE_FAILURES=
