---
import '../styles/global.scss';
import { accueil, footer, navigation, seo } from '../lib/content';
const { title, description, image, noindex } = Astro.props;
const currentPath = Astro.url.pathname.replace(/\/+$/, '') || '/';
const pageTitle = title ?? seo.pageTitles[currentPath] ?? seo.defaultTitle;
const fullTitle = pageTitle === seo.siteName ? seo.siteName : `${pageTitle} — ${seo.siteName}`;
const pageDescription = description ?? seo.defaultDescription;
const base = Astro.site ?? Astro.url;
const canonical = new URL(currentPath, base).href;
const ogImage = new URL(image ?? '/og-default.jpg', base).href;
const hideFromSearch = noindex ?? /^\/(admin|login)(\/|$)/.test(currentPath);
---
<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={pageDescription} />
    <meta name="theme-color" content="#fffdf9" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {hideFromSearch && <meta name="robots" content="noindex, nofollow" />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={seo.siteName} />
    <meta property="og:locale" content="fr_BE" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <script is:inline>document.documentElement.classList.add('js');</script>
  </head>
  <body>
    <a class="skip-link" href="#contenu">Aller au contenu</a>
    <header class="site-header">
      <div class="brand-lockup">
        <a class="logo" href={navigation.brand.homeHref} aria-label={navigation.brand.homeLabel}>{navigation.brand.leading}<span>{navigation.brand.emphasis}</span></a>
        <span class="logo-signature">{accueil.brandSignature}</span>
      </div>
      <nav class="desktop-nav" aria-label={navigation.desktopAriaLabel}>
        {navigation.links.map(({ href, label }) => <a href={href} aria-current={currentPath === href ? 'page' : undefined}>{label}</a>)}
      </nav>
      <a class="header-cta" href={navigation.cta.href}>{navigation.cta.label}</a>
      <a class="login" href={navigation.login.href}>{navigation.login.label}</a>
      <button class="menu-toggle" type="button" aria-label={navigation.menu.openLabel} data-open-label={navigation.menu.openLabel} data-close-label={navigation.menu.closeLabel} aria-expanded="false" aria-controls="mobile-menu">
        <svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" aria-hidden="true" focusable="false">
          <path class="menu-icon-open" d="M3 6h18M3 12h18M3 18h18" />
          <path class="menu-icon-close" d="M5 5l14 14M19 5L5 19" />
        </svg>
      </button>
    </header>
    <div class="mobile-menu" id="mobile-menu" hidden>
      <nav aria-label={navigation.mobileAriaLabel}>
        {navigation.links.map(({ href, label }) => <a href={href} aria-current={currentPath === href ? 'page' : undefined}>{label}</a>)}<a class="mobile-login" href={navigation.cta.href}>{navigation.cta.label}</a>
      </nav>
    </div>
    <main id="contenu" tabindex="-1"><slot /></main>
    <footer class="site-footer">
      <div class="footer-main">
        <div class="footer-brand">
          <a class="logo" href={footer.homeHref}>{navigation.brand.leading}<span>{navigation.brand.emphasis}</span></a>
          <p>{footer.tagline}</p>
        </div>
        <nav aria-label={footer.navLabel}>
          <a href={footer.press.href}>{footer.press.label}</a>
          <a href={footer.contact.href}>{footer.contact.label}</a>
          <a href={footer.instagram.href} target="_blank" rel="noreferrer">{footer.instagram.label}</a>
        </nav>
      </div>
      <div class="footer-legal">
        <span>{footer.copyright}</span>
        <a href={footer.legal.href}>{footer.legal.label}</a>
        <a href={footer.login.href}>{footer.login.label}</a>
      </div>
    </footer>
    <script>
      const toggle = document.querySelector<HTMLButtonElement>('.menu-toggle');
      const menu = document.querySelector<HTMLElement>('#mobile-menu');
      const menuLinks = menu ? Array.from(menu.querySelectorAll<HTMLElement>('a')) : [];
      const openLabel = toggle?.dataset.openLabel;
      const closeLabel = toggle?.dataset.closeLabel;
      const closeMenu = () => { if (!toggle || !menu) return; if (!openLabel) throw new Error('Missing mobile menu open label'); toggle.setAttribute('aria-expanded', 'false'); toggle.setAttribute('aria-label', openLabel); menu.hidden = true; document.body.classList.remove('menu-open'); };
      toggle?.addEventListener('click', () => { if (!menu) return; if (!openLabel || !closeLabel) throw new Error('Missing mobile menu labels'); const open = toggle.getAttribute('aria-expanded') !== 'true'; toggle.setAttribute('aria-expanded', String(open)); toggle.setAttribute('aria-label', open ? closeLabel : openLabel); menu.hidden = !open; document.body.classList.toggle('menu-open', open); if (open) menuLinks[0]?.focus(); });
      menuLinks.forEach((link) => link.addEventListener('click', closeMenu));
      document.addEventListener('keydown', (event) => { if (event.key === 'Escape' && menu && !menu.hidden) { closeMenu(); toggle?.focus(); } if (event.key === 'Tab' && menu && !menu.hidden && menuLinks.length) { const first = menuLinks[0], last = menuLinks.at(-1); if (event.shiftKey && document.activeElement === first) { event.preventDefault(); last?.focus(); } else if (!event.shiftKey && document.activeElement === last) { event.preventDefault(); first.focus(); } } });
      window.matchMedia('(max-width: 760px)').addEventListener('change', (event) => { if (!event.matches) closeMenu(); });

      if (!matchMedia('(prefers-reduced-motion: reduce)').matches && 'IntersectionObserver' in window) {
        const io = new IntersectionObserver((entries) => entries.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('is-visible'); io.unobserve(e.target); } }), { rootMargin: '0px 0px -8% 0px', threshold: 0.08 });
        document.querySelectorAll('.work-card, .offer-card, .workshop-grid article, .contact-list article, .about-copy figure, .press, .about-tease').forEach((el) => {
          if (el.getBoundingClientRect().top < window.innerHeight) return;
          el.classList.add('reveal'); io.observe(el);
        });
      }
    </script>
  </body>
</html>