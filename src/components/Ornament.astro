---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

interface Props {
  src: ImageMetadata;
  class?: string;
  size?: 'small' | 'medium' | 'large';
  loading?: 'eager' | 'lazy';
}

const { src, class: className, size = 'medium', loading = 'lazy' } = Astro.props;
---
<Image
  src={src}
  alt=""
  aria-hidden="true"
  class:list={['ornament', `ornament--${size}`, className]}
  widths={[96, 144, 192, 288, 384]}
  sizes="(max-width: 760px) 28vw, 180px"
  loading={loading}
  decoding="async"
/>
