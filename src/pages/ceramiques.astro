---
import BaseLayout from '../layouts/BaseLayout.astro';
import ArtworkGallery from '../components/ArtworkGallery.astro';
import Ornament from '../components/Ornament.astro';
import { artworks } from '../data/artworks';
import { ornaments } from '../data/ornaments';
import { publishedPortfolio } from '../lib/portfolio';
const remoteArtworks = await publishedPortfolio(Astro.cookies, Astro.request, 'ceramique');
const galleryArtworks = [...remoteArtworks, ...artworks.filter((local) => local.category === 'ceramique' && !remoteArtworks.some((remote) => remote.slug === local.slug))];
---
<BaseLayout title="Céramiques"><section class="page gallery-page ornamented-intro"><div><p class="eyebrow">Collection</p><h1>Terre &amp; Mer.es</h1><p>Objets singuliers, céramiques peintes et matières marines façonnés à l’atelier.</p></div><div class="ornament-trio"><Ornament src={ornaments.marineAmphora} size="large" loading="eager" /><Ornament src={ornaments.shellCoral} size="small" loading="eager" /><Ornament src={ornaments.celestialCrab} size="small" loading="eager" /></div></section><ArtworkGallery artworks={galleryArtworks} title="La collection" /></BaseLayout>
