---
import BaseLayout from '../layouts/BaseLayout.astro';
import ArtworkGallery from '../components/ArtworkGallery.astro';
import { artworks } from '../data/artworks';
import { publishedPortfolio } from '../lib/portfolio';
const remoteArtworks = await publishedPortfolio(Astro.cookies, Astro.request, 'illustration');
const galleryArtworks = [...remoteArtworks, ...artworks.filter((local) => local.category === 'illustration' && !remoteArtworks.some((remote) => remote.slug === local.slug))];
---
<BaseLayout title="Illustrations"><section class="page gallery-page"><p class="eyebrow">Portfolio</p><h1>Illustrations</h1><p>Des images au trait, à la lisière des signes et des histoires.</p></section><ArtworkGallery artworks={galleryArtworks} title="Les illustrations" /></BaseLayout>
