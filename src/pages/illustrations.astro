---
import BaseLayout from '../layouts/BaseLayout.astro';
import ArrowIcon from '../components/ArrowIcon.astro';
import ArtworkGallery from '../components/ArtworkGallery.astro';
import EditorialGallery from '../components/EditorialGallery.astro';
import type { ImageMetadata } from 'astro';
import Ornament from '../components/Ornament.astro';
import { artworks } from '../data/artworks';
import { ornaments } from '../data/ornaments';
import { publishedPortfolio } from '../lib/portfolio';
import { illustrations as illustrationsContent } from '../lib/content';
const remoteArtworks = await publishedPortfolio(Astro.cookies, Astro.request, 'illustration');
const galleryArtworks = [...remoteArtworks, ...artworks.filter((local) => local.category === 'illustration' && !remoteArtworks.some((remote) => remote.slug === local.slug))];
const portfolio = Object.entries(import.meta.glob<{ default: ImageMetadata }>('../assets/editorial/illustrations/portfolio/*.webp', { eager: true })).sort(([a], [b]) => a.localeCompare(b)).map(([, module]) => module.default);
---
<BaseLayout><section class="page gallery-page ornamented-intro"><div><p class="eyebrow">{illustrationsContent.intro.eyebrow}</p><h1>{illustrationsContent.intro.title}</h1><p>{illustrationsContent.intro.description}</p></div><div class="ornament-pair"><Ornament src={ornaments.lilyPen} size="large" loading="eager" widths={[192, 288, 384, 512, 768]} sizes="(max-width: 760px) 168px, (max-width: 823px) 210px, (max-width: 1530px) 25.5vw, 390px" /></div></section><ArtworkGallery artworks={galleryArtworks} title={illustrationsContent.galleryTitle} filters={false} /><section id="portfolio" class="section editorial-section"><div class="cabinet-heading"><span aria-hidden="true"></span><p class="eyebrow">{illustrationsContent.portfolio.eyebrow}</p><span aria-hidden="true"></span></div><h2>{illustrationsContent.portfolio.title}</h2><EditorialGallery images={portfolio} label={illustrationsContent.portfolio.galleryLabel} /><p><a class="text-link arrow-link" href={illustrationsContent.portfolio.downloadHref}>{illustrationsContent.portfolio.downloadLink} <ArrowIcon /></a></p><p><a class="text-link arrow-link" href={illustrationsContent.portfolio.projectHref}>{illustrationsContent.portfolio.projectLink} <ArrowIcon /></a></p></section></BaseLayout>
