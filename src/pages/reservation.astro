---
import BaseLayout from '../layouts/BaseLayout.astro';
import ArrowIcon from '../components/ArrowIcon.astro';
import Ornament from '../components/Ornament.astro';
import { bookingServices, isBookingService, parisDay, paymentOnSite } from '../data/booking';
import { ornaments } from '../data/ornaments';
import '../styles/reservation.scss';
import { reservation as reservationContent } from '../lib/content';
const requested = Astro.url.searchParams.get('offre');
const selected = isBookingService(requested) ? requested : null;
Astro.response.headers.set('Cache-Control', 'no-store');
---
<BaseLayout>
  <section class="reservation booking page" id="booking">
    <div class="page-title-row"><div><p class="eyebrow">{reservationContent.intro.eyebrow}</p><h1>{reservationContent.intro.title}</h1></div><Ornament src={ornaments.celestialWatch} size="large" loading="eager" /></div>
    <noscript><p class="notice">{reservationContent.noscript.beforeLink} <a href={reservationContent.noscript.contactHref}>{reservationContent.noscript.link}</a>{reservationContent.noscript.afterLink}</p></noscript>
    <nav aria-label={reservationContent.progress.ariaLabel} id="booking-progress">
      <ol class="booking-progress">
        {reservationContent.progress.labels.map((label, index) => <li data-progress={index + 1} aria-current={index === 0 ? 'step' : undefined}><span aria-hidden="true">0{index + 1}</span>{label}</li>)}
      </ol>
    </nav>
    <p class="booking-error" id="booking-error" role="alert" tabindex="-1" hidden></p>
    <form id="booking-form" novalidate>
      <section data-step="1" aria-labelledby="step-1-title">
        <p class="eyebrow">{reservationContent.steps.service.eyebrow}</p>
        <h2 id="step-1-title" tabindex="-1">{reservationContent.steps.service.title}</h2>
        <fieldset class="booking-services">
          <legend class="booking-sr-only">{reservationContent.steps.service.legend}</legend>
          {Object.entries(bookingServices).map(([slug, offer], index) => <label class="booking-service">
            <input type="radio" name="service" value={slug} checked={selected === slug} />
            <span class="eyebrow" aria-hidden="true">{reservationContent.steps.service.servicePrefix} 0{index + 1}<span class="booking-selected">{reservationContent.steps.service.selectedLabel}</span></span>
            <strong>{offer.title}</strong><span class="booking-description">{offer.description}</span>
            <span class="booking-price">{offer.price} € <span aria-hidden="true">·</span> {offer.duration} {reservationContent.messages.serviceDurationUnit}</span>
          </label>)}
        </fieldset>
        <p class="booking-note">{paymentOnSite}</p>
        <div class="booking-actions"><button type="button" data-next disabled={!selected}>{reservationContent.buttons.continue} <span aria-hidden="true">→</span></button></div>
      </section>
      <section data-step="2" aria-labelledby="step-2-title" hidden>
        <p class="eyebrow">{reservationContent.steps.date.eyebrow}</p>
        <h2 id="step-2-title" tabindex="-1">{reservationContent.steps.date.title}</h2>
        <p class="booking-context" data-service-context></p>
        <label for="booking-day">{reservationContent.steps.date.dateLabel}</label>
        <input id="booking-day" name="day" type="date" value={parisDay()} min={parisDay()} required />
        <div id="booking-slots" aria-busy="false">
          <p class="booking-note" id="slots-status" role="status"></p>
          <button type="button" id="slots-retry" class="booking-secondary" hidden>{reservationContent.buttons.retry}</button>
          <fieldset id="slots-fieldset" hidden><legend>{reservationContent.steps.date.slotsLegend}</legend><div class="booking-slots" id="slots-options"></div></fieldset>
        </div>
        <div class="booking-actions"><button type="button" data-back class="booking-secondary">{reservationContent.buttons.back}</button><button type="button" data-next disabled>{reservationContent.buttons.continue} <span aria-hidden="true">→</span></button></div>
      </section>
      <section data-step="3" aria-labelledby="step-3-title" hidden>
        <p class="eyebrow">{reservationContent.steps.details.eyebrow}</p>
        <h2 id="step-3-title" tabindex="-1">{reservationContent.steps.details.title}</h2>
        <div class="booking-fields">
          <div><label for="booking-first-name">{reservationContent.steps.details.firstNameLabel}</label><input id="booking-first-name" name="firstName" autocomplete="given-name" maxlength="60" required aria-describedby="firstName-error" /><span class="booking-field-error" id="firstName-error"></span></div>
          <div><label for="booking-last-name">{reservationContent.steps.details.lastNameLabel}</label><input id="booking-last-name" name="lastName" autocomplete="family-name" maxlength="59" required aria-describedby="lastName-error" /><span class="booking-field-error" id="lastName-error"></span></div>
          <div class="booking-email"><label for="booking-email">{reservationContent.steps.details.emailLabel}</label><input id="booking-email" name="email" type="email" autocomplete="email" maxlength="254" required aria-describedby="email-error" /><span class="booking-field-error" id="email-error"></span></div>
        </div>
        <p class="booking-note">{reservationContent.steps.details.privacyBeforeLink} <a href={reservationContent.steps.details.privacyContactHref}>{reservationContent.steps.details.privacyLink}</a>.</p>
        <div class="booking-actions"><button type="button" data-back class="booking-secondary">{reservationContent.buttons.back}</button><button type="button" data-next>{reservationContent.buttons.continue} <span aria-hidden="true">→</span></button></div>
      </section>
      <section data-step="4" aria-labelledby="step-4-title" hidden>
        <p class="eyebrow">{reservationContent.steps.confirmation.eyebrow}</p>
        <h2 id="step-4-title" tabindex="-1">{reservationContent.steps.confirmation.title}</h2>
        <dl class="booking-summary" id="booking-summary"></dl>
        <p class="booking-payment">{paymentOnSite}</p>
        <p class="booking-note" id="booking-submit-status" role="status"></p>
        <div class="booking-actions"><button type="button" data-back class="booking-secondary">{reservationContent.buttons.back}</button><button type="submit" id="booking-submit">{reservationContent.steps.confirmation.submit}</button></div>
      </section>
    </form>
    <section id="booking-confirmed" aria-labelledby="confirmed-title" hidden>
      <p class="eyebrow">{reservationContent.confirmation.eyebrow}</p>
      <h2 id="confirmed-title" tabindex="-1">{reservationContent.confirmation.title}</h2>
      <dl class="booking-summary" id="confirmed-summary"></dl>
      <p class="booking-payment">{paymentOnSite}</p>
      <p class="booking-note" id="booking-mail-status"></p>
      <a class="text-link arrow-link" href={reservationContent.confirmation.questionHref}>{reservationContent.confirmation.questionLink} <ArrowIcon /></a>
    </section>
  </section>
</BaseLayout>
<script>
  import { initBooking } from '../scripts/booking';
  initBooking();
</script>
