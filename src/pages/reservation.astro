---
import BaseLayout from '../layouts/BaseLayout.astro';
import { bookingServices, isBookingService, type BookingServiceSlug } from '../data/booking';
import { supabaseServer } from '../lib/supabase';
const requested = Astro.url.searchParams.get('offre');
const service: BookingServiceSlug = isBookingService(requested) ? requested : 'tarot-solo';
const offer = bookingServices[service];
const day = Astro.url.searchParams.get('jour') || new Date().toLocaleDateString('en-CA', { timeZone: 'Europe/Paris' });
const dayLabel = new Intl.DateTimeFormat('fr-FR', { dateStyle: 'full', timeZone: 'Europe/Paris' }).format(new Date(`${day}T12:00:00`));
const client = supabaseServer(Astro.cookies, Astro.request);
const { data: slots } = client ? await client.rpc('public_available_slots', { p_service_slug: service, p_day: day }) : { data: [] };
const slotLabel = (value: string) => new Intl.DateTimeFormat('fr-FR', { timeZone: 'Europe/Paris', hour: '2-digit', minute: '2-digit', timeZoneName: 'short' }).format(new Date(value));
---
<BaseLayout title="Réserver un tirage"><section class="reservation page" aria-labelledby="reservation-title"><p class="eyebrow">Almanach des rendez-vous</p><h1 id="reservation-title">Réserver un tirage</h1><ol class="booking-steps" aria-label="Étapes de réservation"><li class="is-current"><span>1</span>Choisir le tirage</li><li><span>2</span>Choisir la date</li><li><span>3</span>Choisir l’horaire</li><li><span>4</span>Vos coordonnées</li><li><span>5</span>Confirmation</li></ol><form class="reservation-choice" method="get" data-booking-search><p class="booking-step-label"><span>Étapes 1 &amp; 2</span>Choisir votre tirage et votre date</p><label for="offre">Votre tirage</label><select id="offre" name="offre">{Object.entries(bookingServices).map(([slug, item]) => <option value={slug} selected={slug === service}>{item.title} · {item.price} € · {item.duration} min</option>)}</select><p class="reservation-offer" aria-live="polite"><strong>{offer.title}</strong><span>{offer.price} € · {offer.duration} min</span></p><label for="jour">Choisir un jour</label><input id="jour" name="jour" type="date" value={day} min={new Date().toLocaleDateString('en-CA', { timeZone: 'Europe/Paris' })} /><p class="booking-timezone">Les horaires sont affichés en heure de Paris.</p><button type="submit">Afficher les horaires</button><p class="booking-search-status" role="status" aria-live="polite"></p></form><section class="slot-list" aria-labelledby="slots-title" aria-live="polite"><div class="cabinet-heading"><span aria-hidden="true"></span><p class="eyebrow">Étape 3 · Heures de Paris</p><span aria-hidden="true"></span></div><h2 id="slots-title">Créneaux disponibles</h2>{slots?.length ? <form method="post" action="/api/reservations" data-booking-form data-offer={offer.title} data-price={offer.price} data-duration={offer.duration} data-day={dayLabel}><input type="hidden" name="service" value={service} /><input type="hidden" name="day" value={day} /><fieldset><legend>Choisir un horaire</legend>{slots.map((slot: { start_at: string; end_at: string }) => <label class="slot"><input type="radio" name="startAt" value={slot.start_at} required /><span>{slotLabel(slot.start_at)}</span></label>)}</fieldset><div class="booking-details" hidden><p class="booking-step-label"><span>Étape 4</span>Vos coordonnées</p><label for="name">Votre nom</label><input id="name" name="name" autocomplete="name" required maxlength="120" /><label for="email">Votre e-mail</label><input id="email" name="email" type="email" autocomplete="email" required maxlength="254" /><aside class="booking-summary" aria-live="polite"><p class="eyebrow">Récapitulatif</p><p><strong data-summary="offer"></strong><span data-summary="price"></span></p><p><span data-summary="day"></span><span data-summary="time"></span></p></aside><p class="booking-disclaimer">Aucun rendez-vous n’est créé avant votre confirmation.</p><button type="submit">Confirmer la demande de rendez-vous</button></div></form> : <div class="notice booking-empty"><p>Aucun créneau n’est ouvert pour cette date.</p><p>Choisissez une autre date pour consulter les horaires disponibles.</p></div>}</section></section></BaseLayout>
<script>const searchForm=document.querySelector<HTMLFormElement>('[data-booking-search]');searchForm?.addEventListener('submit',()=>{const button=searchForm.querySelector<HTMLButtonElement>('button[type="submit"]');const status=searchForm.querySelector<HTMLElement>('.booking-search-status');if(button)button.disabled=true;if(status)status.textContent='Recherche des créneaux disponibles…';});const bookingForm=document.querySelector<HTMLFormElement>('[data-booking-form]');const details=bookingForm?.querySelector<HTMLElement>('.booking-details');bookingForm?.querySelectorAll<HTMLInputElement>('input[name="startAt"]').forEach((input)=>input.addEventListener('change',()=>{if(!details||!bookingForm)return;details.hidden=false;details.querySelector<HTMLElement>('[data-summary="offer"]')!.textContent=bookingForm.dataset.offer||'';details.querySelector<HTMLElement>('[data-summary="price"]')!.textContent=`${bookingForm.dataset.price} € · ${bookingForm.dataset.duration} min`;details.querySelector<HTMLElement>('[data-summary="day"]')!.textContent=bookingForm.dataset.day||'';details.querySelector<HTMLElement>('[data-summary="time"]')!.textContent=input.nextElementSibling?.textContent||'';}));</script>
