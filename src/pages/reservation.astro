---
import BaseLayout from '../layouts/BaseLayout.astro';
import { bookingServices, isBookingService, type BookingServiceSlug } from '../data/booking';
import { supabaseServer } from '../lib/supabase';
const requested = Astro.url.searchParams.get('offre');
const service: BookingServiceSlug = isBookingService(requested) ? requested : 'tarot-solo';
const day = Astro.url.searchParams.get('jour') || new Date().toLocaleDateString('en-CA', { timeZone: 'Europe/Paris' });
const client = supabaseServer(Astro.cookies, Astro.request);
const { data: slots } = client ? await client.rpc('public_available_slots', { p_service_slug: service, p_day: day }) : { data: [] };
const confirmed = Astro.url.searchParams.get('confirmation');
const slotLabel = (value: string) => new Intl.DateTimeFormat('fr-FR', { timeZone: 'Europe/Paris', hour: '2-digit', minute: '2-digit', timeZoneName: 'short' }).format(new Date(value));
---
<BaseLayout title="Réserver un tirage"><section class="reservation page"><p class="eyebrow">Almanach des rendez-vous</p><h1>Réserver un tirage</h1>{confirmed ? <p class="notice" role="status">Votre demande est confirmée. Un récapitulatif vous sera envoyé.</p> : <><form class="reservation-choice" method="get"><label for="offre">Votre tirage</label><select id="offre" name="offre">{Object.entries(bookingServices).map(([slug, offer]) => <option value={slug} selected={slug === service}>{offer.title} · {offer.price} € · {offer.duration} min</option>)}</select><label for="jour">Choisir un jour</label><input id="jour" name="jour" type="date" value={day} min={new Date().toLocaleDateString('en-CA', { timeZone: 'Europe/Paris' })} /><button type="submit">Voir les horaires</button></form><section class="slot-list" aria-labelledby="slots-title"><div class="cabinet-heading"><span aria-hidden="true"></span><p class="eyebrow">Heures de Paris</p><span aria-hidden="true"></span></div><h2 id="slots-title">Créneaux disponibles</h2>{slots?.length ? <form method="post" action="/api/reservations"><input type="hidden" name="service" value={service} /><input type="hidden" name="day" value={day} /><fieldset><legend>Choisir un horaire</legend>{slots.map((slot: { start_at: string; end_at: string }) => <label class="slot"><input type="radio" name="startAt" value={slot.start_at} required />{slotLabel(slot.start_at)}</label>)}</fieldset><label for="name">Votre nom</label><input id="name" name="name" autocomplete="name" required maxlength="120" /><label for="email">Votre e-mail</label><input id="email" name="email" type="email" autocomplete="email" required maxlength="254" /><p class="notice">Vous confirmez un {bookingServices[service].title.toLowerCase()} de {bookingServices[service].duration} minutes à {bookingServices[service].price} €.</p><button type="submit">Confirmer le rendez-vous</button></form> : <p class="notice">Aucun créneau n’est ouvert pour ce jour. Séverine publiera ses disponibilités depuis son agenda.</p>}</section></>}</section></BaseLayout>
