---
import ArrowIcon from '../components/ArrowIcon.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import Ornament from '../components/Ornament.astro';
import ArtworkImage from '../components/ArtworkImage.astro';
import location from '../assets/editorial/contact/01.webp';
import { contactEmail, contactHref, contactMotif, contactPageHref } from '../data/contact';
import { ornaments } from '../data/ornaments';
import { contact as contactContent } from '../lib/content';
const requested = Astro.url.searchParams.get('motif');
const selected = requested && Object.hasOwn(contactContent.motives, requested) ? { label: contactMotif(requested).label, href: contactHref(requested) } : null;
---
<BaseLayout>
  <section class="page contact-page" aria-labelledby="contact-title">
    <div class="contact-intro ornamented-intro"><div><p class="eyebrow">{contactContent.intro.eyebrow}</p><h1 id="contact-title">{contactContent.intro.title}</h1><p>{contactContent.intro.description}</p></div><Ornament src={ornaments.sealedEnvelope} size="large" loading="eager" widths={[192, 288, 384, 512, 768]} sizes="(max-width: 306px) 156px, (max-width: 441px) 51vw, (max-width: 760px) 225px, (max-width: 823px) 210px, (max-width: 1530px) 25.5vw, 390px" /></div>
    {selected && <section class="contact-selection" aria-labelledby="contact-selection-title"><p class="eyebrow">{contactContent.selection.eyebrow}</p><h2 id="contact-selection-title">{selected.label}</h2><p>{contactContent.selection.description}</p><a class="contact-action arrow-link" href={selected.href}>{contactContent.selection.openLink} <ArrowIcon /></a><a class="contact-return arrow-link" href={contactContent.selection.returnHref}>{contactContent.selection.returnLink} <ArrowIcon /></a></section>}
    <section class="contact-choices" id="demandes" aria-labelledby="contact-choices-title"><div class="contact-choices-heading"><p class="eyebrow">{contactContent.choices.eyebrow}</p><h2 id="contact-choices-title">{contactContent.choices.title}</h2></div><div class="contact-list">
      {contactContent.choices.items.map(item => <article><span class="contact-number" aria-hidden="true">{item.number}</span><div><h3>{item.title}</h3><p>{item.description}</p>{item.links.map(link => <a class="arrow-link" href={contactPageHref(link.motif)}>{link.label} <ArrowIcon /></a>)}</div></article>)}
    </div></section>
    <div class="contact-direct"><ArtworkImage src={location} alt={contactContent.direct.photoAlt} class="contact-direct-photo" /><div class="contact-direct-copy"><p class="eyebrow">{contactContent.direct.name}</p><p><a class="arrow-link" href={`mailto:${contactEmail}`}>{contactEmail} <ArrowIcon /></a></p><p><a href={contactContent.direct.phoneHref}>{contactContent.direct.phone}</a></p><p><a class="arrow-link" href={contactContent.direct.instagramHref} target="_blank" rel="noreferrer">{contactContent.direct.instagramHandle} <ArrowIcon /></a></p><p><a class="arrow-link" href={contactContent.direct.reservationHref}>{contactContent.direct.reservationLink} <ArrowIcon /></a></p></div></div>
  </section>
</BaseLayout>
