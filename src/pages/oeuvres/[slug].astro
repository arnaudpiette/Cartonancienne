---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArtworkImage from '../../components/ArtworkImage.astro';
import { artworks } from '../../data/artworks';
const artwork = artworks.find((item) => item.slug === Astro.params.slug);
if (!artwork) return new Response('Œuvre introuvable', { status: 404 });
const returnPath = artwork.category === 'ceramique' ? '/ceramiques' : '/illustrations';
---
<BaseLayout title={artwork.title}>
  <article class="artwork-page page">
    <a class="text-link" href={returnPath}>← Retour à la galerie</a>
    <div class="artwork-detail"><ArtworkImage src={artwork.image} alt={artwork.alt} widths={[640,900,1200]} sizes="(max-width: 760px) 100vw, 52vw" /><div><p class="eyebrow">{artwork.categoryLabel}</p><h1>{artwork.title}</h1><p>{artwork.description}</p><p class="artwork-credit">Crédit : {artwork.credit}</p></div></div>
  </article>
</BaseLayout>
