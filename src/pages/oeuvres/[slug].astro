---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArtworkImage from '../../components/ArtworkImage.astro';
import ArrowIcon from '../../components/ArrowIcon.astro';
import { artworks } from '../../data/artworks';
import { contactPageHref } from '../../data/contact';
import { publishedPortfolio } from '../../lib/portfolio';
import { galerie } from '../../lib/content';
const remote = await publishedPortfolio(Astro.cookies, Astro.request);
const all = [...remote, ...artworks.filter((local) => !remote.some((r) => r.slug === local.slug))];
const artwork = all.find((item) => item.slug === Astro.params.slug);
if (!artwork) return Astro.rewrite('/404');
const returnPath = artwork.category === 'ceramique' ? '/ceramiques' : '/illustrations';
const siblings = all.filter((item) => item.category === artwork.category);
const i = siblings.findIndex((item) => item.slug === artwork.slug);
const previous = siblings.length > 1 ? siblings[(i - 1 + siblings.length) % siblings.length] : null;
const next = siblings.length > 1 ? siblings[(i + 1) % siblings.length] : null;
const hasCredit = !!artwork.credit && !/à confirmer|non renseigné/i.test(artwork.credit);
const ogImage = artwork.imageUrl ?? artwork.image?.src;
---
<BaseLayout title={artwork.title} description={artwork.description || undefined} image={ogImage}>
  <article class="artwork-page page">
    <a class="text-link arrow-link" href={returnPath}><ArrowIcon /> {galerie.detail.backLink}</a>
    <div class="artwork-detail">
      <ArtworkImage src={artwork.imageUrl ?? artwork.image} alt={artwork.alt} widths={[640,900,1200]} sizes="(max-width: 760px) 100vw, 52vw" />
      <div>
        <p class="eyebrow">{artwork.categoryLabel}</p>
        <h1>{artwork.title}</h1>
        <p>{artwork.description}</p>
        {artwork.year && <p class="artwork-credit">{galerie.detail.yearLabel} : {artwork.year}</p>}
        {hasCredit && <p class="artwork-credit">{galerie.detail.creditLabel} : {artwork.credit}</p>}
        <a class="text-link arrow-link artwork-cta" href={contactPageHref('oeuvre')}>{galerie.detail.contactLink} <ArrowIcon /></a>
      </div>
    </div>
    {previous && next && (
      <nav class="artwork-pager" aria-label={galerie.detail.navLabel}>
        <a href={`/oeuvres/${previous.slug}`} rel="prev"><span>{galerie.detail.previousLabel}</span><strong>{previous.title}</strong></a>
        <a href={`/oeuvres/${next.slug}`} rel="next"><span>{galerie.detail.nextLabel}</span><strong>{next.title}</strong></a>
      </nav>
    )}
  </article>
</BaseLayout>