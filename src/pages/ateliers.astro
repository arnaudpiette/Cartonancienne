---
import BaseLayout from '../layouts/BaseLayout.astro';
import ArtworkImage from '../components/ArtworkImage.astro';
import { contactPageHref } from '../data/contact';
import frise from '../assets/originals/atelier-frise.jpeg';
import ceramic from '../assets/originals/atelier-ceramique.jpeg';
---
<BaseLayout title="Ateliers"><section class="offer-intro page"><p class="eyebrow">Faire ensemble</p><h1>Ateliers</h1><p>Le pouvoir de l’image, la visualisation créatrice et la magie du papier.</p></section><section class="workshop-grid section" aria-label="Formats d’atelier"><article><ArtworkImage src={frise} alt="Atelier d’illustration autour d’une frise décorative" /><p class="eyebrow">Illustration</p><h2>Personnalise ta frise</h2><p>Initiation à l’illustration décorative au trait : créer une frise au trait pour encadrer une recette, une page de journal ou une journée de voyage.</p></article><article><ArtworkImage src={ceramic} alt="Atelier de décoration sur céramique" /><p class="eyebrow">Céramique</p><h2>Décor sur céramique</h2><p>Un format documenté dans les sources de l’atelier, autour de la décoration sur céramique.</p></article><article><p class="eyebrow">Tarot &amp; visionboard</p><h2>Atelier TV</h2><p>Un moment ludique et inspirant pour explorer la créativité : le tarot de Marseille rencontre le collage intuitif.</p></article><article><p class="eyebrow">Illustration</p><h2>Collages surréalistes</h2><p>Une initiation au collage et au dessin au trait bicolore, pour créer une composition poétique et originale.</p></article></section><section class="workshop-actions section"><div><p class="eyebrow">Ateliers programmés</p><h2>Les prochaines dates</h2><p>Aucune date, lieu, tarif ou inscription confirmés n’a été transmis.</p><a class="text-link" href={contactPageHref('ateliers')}>Demander les prochaines dates →</a></div><div><p class="eyebrow">Privatisation</p><h2>Créer un atelier sur mesure</h2><p>Pour un groupe, une équipe ou une occasion particulière, parlons du format adapté.</p><a class="text-link" href={contactPageHref('privatisation')}>Demander une privatisation →</a></div></section></BaseLayout>
