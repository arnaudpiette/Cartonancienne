---
import BaseLayout from '../layouts/BaseLayout.astro';
import Ornament from '../components/Ornament.astro';
import { ornaments } from '../data/ornaments';
import { supabaseServer } from '../lib/supabase';
import { login as loginContent } from '../lib/content';
let error = '';
if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData(); const username = String(form.get('username') || ''); const password = String(form.get('password') || '');
  const client = supabaseServer(Astro.cookies, Astro.request); const email = import.meta.env.PRIVATE_ADMIN_EMAIL;
  if (!client || !email) error = loginContent.errors.notConfigured;
  else if (username !== 'C@rtosev') error = loginContent.errors.invalidCredentials;
  else { const { error: authError } = await client.auth.signInWithPassword({ email, password }); if (authError) error = loginContent.errors.invalidCredentials; else return Astro.redirect('/admin'); }
}
---
<BaseLayout>
  <section class="page form-wrap login-page">
    <Ornament src={ornaments.moonKey} class="login-ornament" size="large" loading="eager" />
    <p class="eyebrow">{loginContent.eyebrow}</p>
    <h1>{loginContent.title}</h1>
    {error && <p class="notice" role="alert">{error}</p>}
    <form method="post">
      <label for="username">{loginContent.usernameLabel}</label>
      <input id="username" name="username" type="text" autocomplete="username" required />
      <label for="password">{loginContent.passwordLabel}</label>
      <div class="password-field">
        <input id="password" name="password" type="password" autocomplete="current-password" required />
        <button type="button" class="password-toggle" data-password-toggle data-show-label={loginContent.showPassword} data-hide-label={loginContent.hidePassword} aria-controls="password" aria-label={loginContent.showPassword} aria-pressed="false">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
            <path d="M2 12s3.6-6 10-6 10 6 10 6-3.6 6-10 6S2 12 2 12Z" />
            <circle cx="12" cy="12" r="2.7" />
            <path class="password-eye-slash" d="M3 21 21 3" />
          </svg>
        </button>
      </div>
      <button type="submit">{loginContent.submit}</button>
    </form>
  </section>
</BaseLayout>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('[data-password-toggle]');
  const password = document.querySelector<HTMLInputElement>('#password');

  toggle?.addEventListener('click', () => {
    if (!password) return;
    const showLabel = toggle.dataset.showLabel;
    const hideLabel = toggle.dataset.hideLabel;
    if (!showLabel || !hideLabel) throw new Error('Missing password visibility labels');
    const visible = password.type === 'password';
    password.type = visible ? 'text' : 'password';
    toggle.setAttribute('aria-label', visible ? hideLabel : showLabel);
    toggle.setAttribute('aria-pressed', String(visible));
  });
</script>
