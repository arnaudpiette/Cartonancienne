---
import ArrowIcon from '../components/ArrowIcon.astro';
import BaseLayout from '../layouts/BaseLayout.astro'; import ArtworkImage from '../components/ArtworkImage.astro'; import Ornament from '../components/Ornament.astro'; import { ornaments } from '../data/ornaments'; import portrait from '../assets/editorial/bonjour/02.webp'; import atelier from '../assets/editorial/bonjour/01.webp';
import { bonjour } from '../lib/content';
---
<BaseLayout>
  <section class="page about-page" aria-labelledby="about-title">
    <div class="about-intro ornamented-about-intro"><div><p class="eyebrow">{bonjour.intro.eyebrow}</p><h1 id="about-title">{bonjour.intro.title}</h1><p class="about-lead">{bonjour.intro.lead}</p><p class="about-practices">{bonjour.intro.practices}</p></div><Ornament src={ornaments.severineProfile} size="large" loading="eager" /></div>
    <div class="about-composition">
      <figure class="about-portrait"><ArtworkImage src={portrait} alt={bonjour.portrait.alt} loading="eager" /><figcaption>{bonjour.portrait.caption}</figcaption></figure>
      <div class="about-copy">{bonjour.sections.map(section => <><h2>{section.title}</h2>{section.paragraphs.map(paragraph => <p>{paragraph}</p>)}</>)}<p>{bonjour.closing}</p><figure><ArtworkImage src={atelier} alt={bonjour.atelier.alt} /><figcaption>{bonjour.atelier.caption}</figcaption></figure>
        <nav class="about-links" aria-label={bonjour.links.ariaLabel}><p class="eyebrow">{bonjour.links.eyebrow}</p>{bonjour.links.items.map(item => <a class="arrow-link" href={item.href}>{item.label} <ArrowIcon /></a>)}</nav>
      </div>
    </div>
  </section>
</BaseLayout>
