---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { formatParis } from '../../data/booking';
import { isAdmin, supabaseServer } from '../../lib/supabase';
if (!await isAdmin(Astro.cookies, Astro.request)) return Astro.redirect('/login');
const client = supabaseServer(Astro.cookies, Astro.request);
const { data: appointments } = client ? await client.from('appointments').select('id,service_slug,customer_name,customer_email,start_at,end_at,status').gte('end_at', new Date().toISOString()).order('start_at').limit(30) : { data: [] };
const { data: windows } = client ? await client.from('availability_windows').select('id,start_at,end_at,kind,note').gte('end_at', new Date().toISOString()).order('start_at').limit(30) : { data: [] };
const { data: notifications } = client ? await client.from('booking_notifications').select('id,event,status,attempts,last_error,appointments(service_slug,customer_name,customer_email,start_at),booking_notification_deliveries(recipient,status,attempts,last_error)').in('status', ['pending', 'failed']).order('created_at').limit(20) : { data: [] };
const message = Astro.url.searchParams.get('message');
---
<BaseLayout title="Mon agenda"><section class="agenda page"><p class="eyebrow">C@rtosev · espace privé</p><h1>Mon agenda</h1><div class="admin-actions"><a class="login" href="/admin">Œuvres</a><form method="post" action="/api/logout"><button>Déconnexion</button></form></div>{message && <p class="notice" role="status">{message}</p>}<div class="agenda-grid"><form class="agenda-form" method="post" action="/api/admin/agenda"><p class="eyebrow">Disponibilités</p><h2>Ouvrir ou bloquer</h2><label for="start">Début · Europe/Paris</label><input id="start" name="start" type="datetime-local" required /><label for="end">Fin · Europe/Paris</label><input id="end" name="end" type="datetime-local" required /><label for="kind">Action</label><select id="kind" name="kind"><option value="open">Ouvrir les réservations</option><option value="blocked">Bloquer cette période</option></select><label for="note">Note interne</label><input id="note" name="note" maxlength="240" /><button type="submit">Enregistrer la plage</button><p class="notice">Un blocage qui recouvre un rendez-vous confirmé est refusé : aucun rendez-vous n’est effacé.</p></form><section><p class="eyebrow">Plages à venir</p><h2>Disponibilités</h2>{windows?.length ? <ul class="agenda-list">{windows.map((window) => <li><strong>{window.kind === 'open' ? 'Ouvert' : 'Bloqué'}</strong><span>{formatParis(window.start_at)} — {formatParis(window.end_at)}</span>{window.note && <small>{window.note}</small>}</li>)}</ul> : <p class="notice">Aucune plage n’est encore publiée.</p>}</section></div><section class="agenda-appointments"><p class="eyebrow">Prochains rendez-vous</p><h2>Réservations</h2>{appointments?.length ? <ul class="agenda-list">{appointments.map((appointment) => <li><strong>{appointment.service_slug} · {appointment.status}</strong><span>{formatParis(appointment.start_at)}</span><small>{appointment.customer_name} · {appointment.customer_email}</small>{appointment.status === 'confirmed' && <form method="post" action="/api/admin/appointments"><input type="hidden" name="id" value={appointment.id} /><label>Déplacer · Europe/Paris<input name="start" type="datetime-local" required /></label><button name="action" value="move">Déplacer</button><button name="action" value="cancel" formnovalidate>Annuler</button></form>}</li>)}</ul> : <p class="notice">Aucun rendez-vous à venir.</p>}</section><section class="notification-outbox"><p class="eyebrow">Notifications</p><h2>En attente ou en échec</h2>{notifications?.length ? <ul class="agenda-list">{notifications.map((notification: any) => <li><strong>{notification.event} · {notification.status} · {notification.attempts} tentative(s)</strong><span>{notification.appointments?.customer_name} · {notification.appointments?.customer_email}</span>{notification.booking_notification_deliveries?.map((delivery: any) => <small>{delivery.recipient} : {delivery.status} · {delivery.attempts} tentative(s){delivery.last_error ? ` · ${delivery.last_error}` : ''}</small>)}{notification.last_error && <small>{notification.last_error}</small>}<form method="post" action="/api/admin/notifications"><input type="hidden" name="id" value={notification.id} /><button type="submit">Relancer l’envoi</button></form></li>)}</ul> : <p class="notice">Aucune notification en attente.</p>}</section></section></BaseLayout>
