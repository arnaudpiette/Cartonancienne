---
import BaseLayout from '../../layouts/BaseLayout.astro'; import { isAdmin, supabaseServer } from '../../lib/supabase';
if (!await isAdmin(Astro.cookies, Astro.request)) return Astro.redirect('/login');
const client = supabaseServer(Astro.cookies, Astro.request); const { data: works } = client ? await client.from('artworks').select('id,title,status,updated_at').order('updated_at',{ascending:false}) : { data: [] };
---
<BaseLayout title="Administration"><section class="page"><p class="eyebrow">C@rtosev · espace privé</p><h1>Œuvres</h1><div class="admin-actions"><a class="login" href="/admin/oeuvre">Créer une fiche</a><form method="post" action="/api/logout"><button>Déconnexion</button></form></div><div class="notice">Les fiches publiées sont visibles sur le site ; les brouillons restent privés.</div><div class="work-grid">{works?.map((work) => <a class="work-card" href={`/admin/oeuvre?id=${work.id}`}><span>{work.status}</span><h3>{work.title}</h3></a>)}</div></section></BaseLayout>
