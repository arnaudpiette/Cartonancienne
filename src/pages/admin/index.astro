---
import AdminNavigation from '../../components/AdminNavigation.astro'; import BaseLayout from '../../layouts/BaseLayout.astro'; import Ornament from '../../components/Ornament.astro'; import { ornaments } from '../../data/ornaments'; import { isAdmin, supabaseServer } from '../../lib/supabase';
import ArrowIcon from '../../components/ArrowIcon.astro';
if (!await isAdmin(Astro.cookies, Astro.request)) return Astro.redirect('/login');
const client = supabaseServer(Astro.cookies, Astro.request); const { data: works, error: worksError } = client ? await client.from('artworks').select('id,title,status,updated_at').order('updated_at',{ascending:false}) : { data: null, error: true };
---
<BaseLayout title="Administration"><section class="page admin-page"><div class="admin-heading"><div><p class="eyebrow">Espace atelier · administration</p><h1>Œuvres</h1></div><Ornament src={ornaments.risingPhoenix} class="admin-heading-ornament" size="large" /></div><AdminNavigation active="home" /><a class="admin-back arrow-link" href="/admin/ornements">Bibliothèque graphique <ArrowIcon /></a><div class="notice">Les fiches publiées sont visibles sur le site ; les brouillons restent privés.</div><section id="oeuvres" class="admin-works" aria-labelledby="admin-works-title"><h2 id="admin-works-title">Mes œuvres</h2>{worksError ? <p class="notice" role="alert">Impossible de charger les œuvres. Réessayez dans un instant.</p> : works?.length ? <div class="work-grid">{works.map((work) => <a class="work-card" href={`/admin/oeuvre?id=${work.id}`}><span>{work.status}</span><h3>{work.title}</h3></a>)}</div> : <p class="notice">Aucune fiche d’œuvre pour le moment.</p>}<a class="admin-back arrow-link" href="/admin/oeuvre">Créer une fiche <ArrowIcon /></a></section></section></BaseLayout>
