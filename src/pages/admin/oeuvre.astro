---
import BaseLayout from '../../layouts/BaseLayout.astro'; import { isAdmin, supabaseServer } from '../../lib/supabase';
if (!await isAdmin(Astro.cookies, Astro.request)) return Astro.redirect('/login');
const id = Astro.url.searchParams.get('id'); const client = supabaseServer(Astro.cookies, Astro.request);
const { data: artwork } = id && client ? await client.from('artworks').select('id,title,slug,category,description,status,year,show_in_cabinet,display_order,artwork_media(id,alt_text,credit,position,is_cover)').eq('id', id).single() : { data: null };
if (id && !artwork) return new Response('Œuvre introuvable', { status: 404 });
---
<BaseLayout title={artwork ? `Modifier ${artwork.title}` : 'Créer une œuvre'}><section class="page form-wrap"><p class="eyebrow">Fiche œuvre</p><h1>{artwork ? 'Modifier' : 'Créer'}</h1>
<form method="post" action="/api/artworks" enctype="multipart/form-data">{artwork && <input type="hidden" name="id" value={artwork.id} />}
<label>Titre<input name="title" required value={artwork?.title ?? ''} /></label><label>Slug<input name="slug" required pattern="[a-z0-9]+(?:-[a-z0-9]+)*" value={artwork?.slug ?? ''} /></label><small>Lettres minuscules, chiffres et tirets uniquement.</small>
<label>Catégorie<select name="category"><option value="illustration" selected={artwork?.category === 'illustration'}>Illustration</option><option value="ceramique" selected={artwork?.category === 'ceramique'}>Céramique</option></select></label><label>Année<input name="year" type="number" min="1000" max="9999" value={artwork?.year ?? ''} /></label><label>Description<textarea name="description" rows="5">{artwork?.description ?? ''}</textarea></label>
<label>Statut<select name="status"><option value="draft" selected={artwork?.status !== 'published'}>Brouillon</option><option value="published" selected={artwork?.status === 'published'}>Publier</option></select></label><label><input name="show_in_cabinet" type="checkbox" checked={artwork?.show_in_cabinet ?? true} /> Afficher dans le Cabinet de curiosités</label><label>Ordre d’affichage<input name="display_order" type="number" value={artwork?.display_order ?? 0} /></label>
{artwork?.artwork_media?.length ? <section class="notice"><strong>Médias actuels</strong>{artwork.artwork_media.map((media) => <p>{media.is_cover ? 'Couverture · ' : ''}{media.alt_text}</p>)}</section> : null}<label for="photos">Ajouter des images (JPEG, PNG ou WebP, 10 Mo max chacune)</label><input id="photos" name="photos" type="file" accept="image/jpeg,image/png,image/webp" multiple /><div id="media-fields"></div><button type="submit">Enregistrer</button></form>
{artwork && <form method="post" action="/api/artworks" onsubmit="return confirm('Supprimer cette œuvre ? Les fichiers liés sont conservés.')"><input type="hidden" name="intent" value="delete" /><input type="hidden" name="id" value={artwork.id} /><button class="danger" type="submit">Supprimer l’œuvre</button></form>}</section></BaseLayout>
<script>const photos=document.querySelector<HTMLInputElement>('#photos'),fields=document.querySelector('#media-fields');photos?.addEventListener('change',()=>{if(!fields)return;fields.innerHTML=Array.from(photos.files||[]).map((file,i)=>`<fieldset><legend>${file.name}</legend><label>Texte alternatif<input name="alt-${i}" required></label><label>Crédit<input name="credit-${i}"></label><label>Ordre<input name="position-${i}" type="number" value="${i}" min="0"></label><label>Couverture<input type="radio" name="cover" value="${i}" ${i===0?'checked':''}></label></fieldset>`).join('')});</script>
