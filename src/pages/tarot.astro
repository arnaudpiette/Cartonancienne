---
import BaseLayout from '../layouts/BaseLayout.astro';
import ArtworkImage from '../components/ArtworkImage.astro';
import { contactPageHref } from '../data/contact';
import { reservationHref } from '../data/booking';
import tarot from '../assets/originals/tarot.jpg';
---
<BaseLayout title="Tarot">
  <section class="offer-intro tarot-intro page"><p class="eyebrow">Retour aux sources</p><h1>Le Bon Tarot</h1><div class="tarot-intro-grid"><ArtworkImage src={tarot} alt="Le Bon Tarot de Séverine Piette" /><div class="tarot-intro-copy"><p>Découvrez la voie initiatique du tarot de Marseille comme outil de connaissance de soi.</p><p>Les cartes résonnent en miroir avec l’imagination et le vécu pour offrir une nouvelle lecture d’une situation donnée, ouvrir des portes de conscience et d’action.</p><a class="text-link" href="#tarot-offers">Découvrir les tirages <span aria-hidden="true">↓</span></a></div></div></section>
  <section class="offers section" aria-labelledby="tarot-offers"><div class="cabinet-heading"><span aria-hidden="true"></span><p class="eyebrow">Quatre services</p><span aria-hidden="true"></span></div><h2 id="tarot-offers">Choisir une porte</h2><div class="offer-grid"><article class="offer-card offer-card-bookable"><p class="eyebrow">01</p><p class="offer-status">Réservation en ligne</p><h3>Rendez-vous solo</h3><p>Une question à poser, un domaine à explorer avec le tarot de Marseille.</p><p class="offer-price">50 € · 60 min</p><a class="text-link" href={reservationHref('tarot-solo')}>Réserver un tirage <span aria-hidden="true">→</span></a></article><article class="offer-card offer-card-bookable"><p class="eyebrow">02</p><p class="offer-status">Réservation en ligne</p><h3>La roue astrologique</h3><p>Une lecture à 12 cartes, pour accompagner le mouvement de votre année et éclairer les secteurs de vie.</p><p class="offer-price">70 € · 90 min</p><a class="text-link" href={reservationHref('roue-astrologique')}>Réserver un tirage <span aria-hidden="true">→</span></a></article><article class="offer-card"><p class="eyebrow">03</p><h3>Tarot événementiel</h3><p>Une proposition à imaginer ensemble, à la demande.</p><a class="text-link" href={contactPageHref('tarot-evenementiel')}>Parler de votre événement <span aria-hidden="true">→</span></a></article><article class="offer-card"><p class="eyebrow">04</p><h3>Le Bon Tarot</h3><p>Un jeu de cartes et un apprentissage par les symboles, les cycles et le langage poétique des images.</p><a class="text-link" href={contactPageHref('bon-tarot')}>En savoir plus <span aria-hidden="true">→</span></a></article></div></section>
</BaseLayout>
