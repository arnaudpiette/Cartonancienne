---
import BaseLayout from '../layouts/BaseLayout.astro';
import ArrowIcon from '../components/ArrowIcon.astro';
import ArtworkImage from '../components/ArtworkImage.astro';
import Ornament from '../components/Ornament.astro';
import EditorialGallery from '../components/EditorialGallery.astro';
import type { ImageMetadata } from 'astro';
const tarotImages = Object.entries(import.meta.glob<{ default: ImageMetadata }>('../assets/editorial/tarot/*.webp', { eager: true })).sort(([a], [b]) => a.localeCompare(b)).map(([, item]) => item.default);
import { contactPageHref } from '../data/contact';
import { bookingServices, reservationHref } from '../data/booking';
import { ornaments } from '../data/ornaments';
import tarotArtwork from '../assets/originals/tarot.jpg';
import { tarot as tarotContent } from '../lib/content';
---
<BaseLayout>
  <section class="offer-intro tarot-intro page ornamented-page"><div class="page-title-row"><div><p class="eyebrow">{tarotContent.intro.eyebrow}</p><h1>{tarotContent.intro.title}</h1></div><div class="tarot-symbols"><Ornament src={ornaments.radiantSun} size="medium" loading="eager" widths={[192, 288, 384, 576, 768]} sizes="(max-width: 760px) 65vw, 25vw" /><Ornament src={ornaments.crescentMoon} size="small" loading="eager" widths={[192, 288, 384, 576]} sizes="(max-width: 760px) 32vw, 13vw" /></div></div><div class="tarot-intro-grid"><ArtworkImage src={tarotArtwork} alt={tarotContent.intro.imageAlt} /><div class="tarot-intro-copy"><Ornament src={ornaments.mysticEye} size="small" widths={[192, 288, 384, 576]} sizes="(max-width: 760px) 62vw, 19vw" />{tarotContent.intro.paragraphs.map(paragraph => <p>{paragraph}</p>)}<a class="text-link arrow-link" href={tarotContent.intro.linkHref}>{tarotContent.intro.link} <ArrowIcon /></a></div></div></section>
  <section class="offers section" aria-labelledby="tarot-offers"><div class="cabinet-heading"><span aria-hidden="true"></span><p class="eyebrow">{tarotContent.offersHeading.eyebrow}</p><span aria-hidden="true"></span></div><h2 id="tarot-offers">{tarotContent.offersHeading.title}</h2><Ornament src={ornaments.moonDoorway} class="section-side-ornament" size="medium" widths={[192, 288, 384, 576, 768]} sizes="(max-width: 760px) 55vw, 24vw" /><div class="offer-grid">
    <article class="offer-card offer-card-bookable"><p class="eyebrow">{tarotContent.offers.solo.number}</p><p class="offer-status">{tarotContent.offers.solo.status}</p><h3>{tarotContent.offers.solo.title}</h3><p>{bookingServices['tarot-solo'].description}</p><p class="offer-price">{bookingServices['tarot-solo'].price} € · {bookingServices['tarot-solo'].duration} {tarotContent.pricingDurationUnit}</p><a class="text-link arrow-link" href={reservationHref('tarot-solo')}>{tarotContent.offers.solo.link} <ArrowIcon /></a></article>
    <article class="offer-card offer-card-bookable"><p class="eyebrow">{tarotContent.offers.astrologicalWheel.number}</p><p class="offer-status">{tarotContent.offers.astrologicalWheel.status}</p><h3>{tarotContent.offers.astrologicalWheel.title}</h3><p>{bookingServices['roue-astrologique'].description}</p><p class="offer-price">{bookingServices['roue-astrologique'].price} € · {bookingServices['roue-astrologique'].duration} {tarotContent.pricingDurationUnit}</p><a class="text-link arrow-link" href={reservationHref('roue-astrologique')}>{tarotContent.offers.astrologicalWheel.link} <ArrowIcon /></a></article>
    <article class="offer-card"><p class="eyebrow">{tarotContent.offers.event.number}</p><h3>{tarotContent.offers.event.title}</h3><p>{tarotContent.offers.event.description}</p><a class="text-link arrow-link" href={contactPageHref(tarotContent.offers.event.contactMotif)}>{tarotContent.offers.event.link} <ArrowIcon /></a></article>
    <article class="offer-card"><p class="eyebrow">{tarotContent.offers.gift.number}</p><h3>{tarotContent.offers.gift.title}</h3><p>{tarotContent.offers.gift.description}</p><a class="text-link arrow-link" href={contactPageHref(tarotContent.offers.gift.contactMotif)}>{tarotContent.offers.gift.link} <ArrowIcon /></a></article>
  </div></section>
  <section class="section editorial-section"><p class="eyebrow">{tarotContent.editorial.eyebrow}</p><h2>{tarotContent.editorial.title}</h2>{tarotContent.editorial.paragraphs.map(paragraph => <p>{paragraph}</p>)}<EditorialGallery images={tarotImages} label={tarotContent.editorial.galleryLabel} /></section>
</BaseLayout>
